set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR tricore)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
get_filename_component(TRICORE_PACKAGE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(TRICORE_TOOLCHAIN_ROOT "${TRICORE_PACKAGE_ROOT}/tools/tricore" CACHE PATH "TriCore installation directory")
set(TRICORE_CPU "tc26xx" CACHE STRING "TriCore CPU passed to -mcpu")
set(TRICORE_BIN "${TRICORE_TOOLCHAIN_ROOT}/bin")
set(CMAKE_C_COMPILER "${TRICORE_BIN}/tricore-elf-gcc")
set(CMAKE_CXX_COMPILER "${TRICORE_BIN}/tricore-elf-g++")
set(CMAKE_ASM_COMPILER "${TRICORE_BIN}/tricore-elf-gcc")
set(CMAKE_AR "${TRICORE_BIN}/tricore-elf-ar")
set(CMAKE_RANLIB "${TRICORE_BIN}/tricore-elf-ranlib")
set(CMAKE_OBJCOPY "${TRICORE_BIN}/tricore-elf-objcopy")
set(CMAKE_SIZE "${TRICORE_BIN}/tricore-elf-size")
set(CMAKE_C_FLAGS_INIT "-mcpu=${TRICORE_CPU}")
set(CMAKE_CXX_FLAGS_INIT "-mcpu=${TRICORE_CPU}")
set(CMAKE_ASM_FLAGS_INIT "-mcpu=${TRICORE_CPU}")
